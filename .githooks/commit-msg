#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "Usage: $0 <commit-message-file>" >&2
  exit 2
fi

COMMIT_MSG_FILE="$1"

if ! git interpret-trailers --parse "$COMMIT_MSG_FILE" |
  grep -qE '^Signed-off-by:[[:space:]]+.+[[:space:]]+<[^<>[:space:]]+@[^<>[:space:]]+>$'; then
  echo "❌ Error: Missing or invalid 'Signed-off-by:' trailer."
  echo "💡 Tip: Use 'git commit -s' to add it automatically."
  exit 1
fi

HEADER_LINE="$(head -n 1 "$COMMIT_MSG_FILE")"

if [[ "${#HEADER_LINE}" -gt 72 ]]; then
  echo "❌ Error: Commit subject is too long (${#HEADER_LINE} characters). Max: 72."
  exit 1
fi

PATTERN="^(feat|fix|refactor|test|docs|deps|chore|perf|ci)(\([^)]+\))?: .+"

if ! [[ "$HEADER_LINE" =~ $PATTERN ]]; then
  echo "❌ Error: Invalid commit format."
  echo "Expected format: <type>: <subject>"
  echo "Allowed types: feat, fix, refactor, test, docs, deps, chore, perf, ci"
  echo "Example: ci: enforce commit sign-off"
  exit 1
fi

echo "✅ Commit format validated locally."
